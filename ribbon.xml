<customUI xmlns="http://schemas.microsoft.com/office/2009/07/customui" onLoad="OnAddinLoad">
  <ribbon>
    <tabs>
      <tab id="ParaphrasingTab" label="同义替换">
        <group id="ParaphrasingGroup" label="改写">
          <button id="btnShowPane" label="同义候选" onAction="OnShowPane" size="large" getImage="OnGetImage"/>
        </group>
      </tab>
    </tabs>
  </ribbon>
  <contextMenus>
    <contextMenu idMso="ContextMenuText">
      <menuSeparator id="ParaphraseSeparator" getVisible="OnGetSeparatorVisible"/>
      <button id="btnParaphraseCtx" label="同义替换" onAction="OnContextMenuParaphrase" getVisible="OnGetContextMenuVisible"/>
    </contextMenu>
  </contextMenus>
</customUI>
